VITE_TURSO_URL=libsql://your-database.turso.io
VITE_TURSO_AUTH_TOKEN=your-token-here
# WhatsApp del equipo de bodega para el botón "Requisición" (formato wa.me:
# código de país + número, solo dígitos, sin +, espacios ni guiones).
VITE_WHATSAPP_BODEGA_NUMBER=50212345678

# URL del Update API (Cloudflare Worker, ver update-api/ y
# docs/DISTRIBUTION.md) — no es un secreto, se hornea igual que las de
# arriba, pero por sí sola no da acceso a nada sin una credencial de
# instalación válida.
VITE_UPDATE_API_URL=https://clio-update-api.your-subdomain.workers.dev

# Solo para correr scripts/create-installations-db-schema.mjs a mano — NO
# se hornean en el bundle de CLIO (sin prefijo VITE_, Vite no los expone al
# frontend) y NO son las mismas credenciales que usa el Worker en
# producción (esas van como `wrangler secret put`, nunca acá). Es la base
# Turso de licenciamiento, separada de VITE_TURSO_URL de arriba.
INSTALLATIONS_TURSO_URL=libsql://your-installations-database.turso.io
INSTALLATIONS_TURSO_TOKEN=your-token-here
